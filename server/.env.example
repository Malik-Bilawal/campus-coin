# Server Environment Example
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database — prefer local, Atlas as fallback
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/campuscoin
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/campuscoin
MONGODB_TIMEOUT_MS=8000
TRY_ATLAS_FIRST=false

# JWT
JWT_ACCESS_SECRET=change_me_32chars_min
JWT_REFRESH_SECRET=change_me_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AI (Phase 2)
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
