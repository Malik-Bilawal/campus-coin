# Server Environment Example
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database â€” prefer local, Atlas as fallback
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/campuscoin
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/campuscoin
MONGODB_TIMEOUT_MS=8000
TRY_ATLAS_FIRST=false

# JWT
JWT_ACCESS_SECRET=change_me_32chars_min
JWT_REFRESH_SECRET=change_me_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AI (Phase 2)
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=

# SMTP mail (optional — OTP + password-reset emails; without SMTP_HOST the app
# falls back to console log + dev payload in development)
# Gmail app password example: smtp.gmail.com / 587 / your Gmail + app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Coin <no-reply@campuscoin.app>
